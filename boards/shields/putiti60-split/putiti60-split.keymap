#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define WIN 3
#define WIN_FN1 4

/ {
	keymap {
		compatible = "zmk,keymap";

		macos {
			display-name = "MacOS";
			bindings = <
				&kp F1    &kp F2   &kp F3   &kp F4   &kp F5    &kp F6          &kp F7   &kp F8 &kp F9    &kp F10 &kp F11  &kp F12
				&kp TAB   &kp Q    &kp W    &kp E    &kp R     &kp T           &kp Y    &kp U  &kp I     &kp O   &kp P    &kp DEL
				&kp LSHFT &kp A    &kp S    &kp D    &kp F     &kp G           &kp H    &kp J  &kp K     &kp L   &kp SEMI &kp SQT
				&kp LCTRL &kp Z    &kp X    &kp C    &kp V     &kp B           &kp N    &kp M  &kp COMMA &kp DOT &kp FSLH &trans
				          &kp C_PP &kp LALT &kp LGUI &kp SPACE &kp ENTER       &kp BSPC &mo 1  &mo 2     &trans  &tog WIN 
			>;
                        // sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP       &inc_dec_kp PG_UP PG_DN>;
		};

		macos_fn1 {
			display-name = "MacOS Fn1";
			bindings = <
               &trans  &trans &trans       &trans   &trans        &trans           &trans    &trans   &trans   &trans    &trans  &trans
               &kp ESC &trans &kp LG(LEFT) &kp UP   &kp LG(RIGHT) &kp PG_UP        &kp EQUAL &kp LBRC &kp RBRC &trans    &trans  &trans
               &trans  &trans &kp LEFT     &kp DOWN &kp RIGHT     &kp PG_DN        &kp MINUS &kp LPAR &kp RPAR &kp GRAVE &trans  &trans   
               &trans  &trans &kp SQT      &kp BSLH &kp RBKT      &trans           &kp SQT   &kp LBKT &kp RBKT &trans    &trans  &trans
                       &trans &trans       &trans   &trans        &trans           &trans    &trans   &trans   &trans    &trans
			>; 
		};


		l2 {
			display-name = "MacOS Fn2";
			bindings = <
                &trans   &trans   &trans   &trans   &trans   &trans          &trans &trans &trans &bt BT_CLR &bt BT_PRV &bt BT_NXT
                &trans   &kp N1   &kp N2   &kp N3   &kp N4   &kp N5          &kp N6 &kp N7 &kp N8 &kp N9     &kp N0     &kp RSHFT
                &kp CAPS &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT       &trans &trans &trans &trans     &trans     &trans
                &trans   &kp PIPE &kp BSLH &kp AMPS &kp STAR &kp CARET       &trans &trans &trans &trans     &trans     &trans 
                         &trans   &trans   &trans   &trans   &trans          &trans &trans &trans &trans     &trans     
			>;
		};
	
		windows {
			display-name = "Win";
			bindings = <
				&kp ESC  &kp N1 &kp N2 &kp N3    &kp N4 &kp N5          &kp N6 &kp N7      &kp N8 &kp N9 &kp N0 &kp RSHFT
				&trans   &trans &trans &trans    &trans &trans          &trans &trans      &trans &trans &trans &trans
				&trans   &trans &trans &trans    &trans &trans          &trans &trans      &trans &trans &trans &trans
				&kp LGUI &trans &trans &trans    &trans &trans          &trans &trans      &trans &trans &trans &trans
				         &trans &trans &kp LCTRL &trans &trans          &trans &mo WIN_FN1 &mo 2  &trans &trans 
			>;
		};

		windows_fn1 {
			display-name = "Win Fn1";
			bindings = <
               &kp F1 &kp F2 &kp F3   &kp F4   &kp F5    &kp F6               &kp F7    &kp F8   &kp F9   &kp F10   &kp F11 &kp F12
               &trans &trans &kp HOME &kp UP   &kp END   &kp PG_UP            &kp EQUAL &kp LBRC &kp RBRC &trans    &trans  &trans
               &trans &trans &kp LEFT &kp DOWN &kp RIGHT &kp PG_DN            &kp MINUS &kp LPAR &kp RPAR &kp GRAVE &trans  &trans   
               &trans &trans &kp SQT  &kp BSLH &kp RBKT  &trans               &kp SQT   &kp LBKT &kp RBKT &trans    &trans  &trans
                      &trans &trans   &trans   &trans    &trans               &trans    &trans   &trans   &trans    &trans  
			>; 
		};
	};
};